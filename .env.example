# =============================================================================
# Frontend (Vite) — 값을 채워 사용. 실제 키는 커밋 금지.
# 이 세 값은 Supabase/Lovable Cloud 연결 시 자동 주입됩니다.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# =============================================================================
# Edge Function secrets (Supabase secrets에만 저장).
# ※ 아래 값들은 절대 프론트 .env 에 넣지 말 것.
#    Supabase Dashboard → Edge Functions → Secrets 로만 관리.
# =============================================================================
# OPENAI_API_KEY=            # generate-scenario: OpenAI Chat Completions
# ELEVENLABS_API_KEY=        # tts: 음성 합성 (사용 시)
# SUPADATA_API_KEY=          # youtube-transcript: YouTube 자막 추출
# SUPABASE_SERVICE_ROLE_KEY= # Edge Function 서버측 DB 접근 (RLS 우회)
