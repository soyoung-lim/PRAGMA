# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.npm-cache/
dist
dist-ssr
*.local

# Environment files — keep secrets out of git; .env.example is the template
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
supabase/.temp/
.tmp/

# 에이전트 도구 — 머신별 설정은 공유하지 않고, 공용 실행 설정(launch.json)만 추적한다
.claude/settings.local.json

# 로컬 병렬 작업공간·임시 추출물 — 실제 파일은 보존하되 웹앱 저장소에는 넣지 않는다
.worktrees/
tmp/

# 수동 백업본 (예: CLAUDE.md.bak-20260723) — 정본은 항상 원본 파일
*.bak-*

# 교차 벤더 검토 배치 결과(연구 산출물 — 저장소에 올리지 않는다)
cross-vendor-review-out/

# HSK 3.0 공식 대강의 축자 전사와 그 파생 seed — 재배포 권리 문제로 저장소에 두지 않는다.
# 로컬 파일은 그대로 유지하며, 근거 대조는 data/hsk3/source-manifest.json의 sha256으로 한다.
/data/hsk3/source/
/supabase/seed/

# 시점 종속 내부 상태판 — 갱신하지 않으면 곧 사실과 어긋난다(로컬에는 유지).
/docs/handoff/ACTIVE_HANDOFF.md
